{
	"author": "Toufiqur Rahaman Chowdhury",
	"bugs": {
		"url": "https://github.com/alien45/superutils/issues"
	},
	"description": "A set of small, focused utilities for working with RxJS observables and subjects.",
	"dependencies": {
		"@superutils/core": "^1.2.22",
		"@superutils/promise": "^1.3.24",
		"rxjs": "^7.8.2"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"homepage": "https://alien45.github.io/superutils/packages/@superutils/rx/",
	"keywords": [
		"rxjs",
		"utils",
		"typescript",
		"reactive"
	],
	"license": "MIT",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"name": "@superutils/rx",
	"peerDependencies": {
		"@superutils/core": "*",
		"@superutils/promise": "*",
		"rxjs": "*"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/alien45/superutils.git"
	},
	"scripts": {
		"_build": "tsc -p tsconfig.json",
		"_watch": "tsc -p tsconfig.json --watch",
		"build": "tsup --config ../../tsup.config.js",
		"dev": "npm run build -- --watch",
		"start": "npm run dev",
		"test": "cd ../../ && npm run test rx"
	},
	"sideEffects": false,
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "0.1.19"
}
